# ZUBAIR MEDICAL COMPLEX JHELUM
# Production Environment Variables
# Copy this file to .env.local for local development.
# In Vercel, add each variable via: Settings → Environment Variables

# ── Authentication ────────────────────────────────────────────────────────────
AUTH_SECRET=zmc_jhelum_secure_token_secret_key_2026_production

# ── Supabase (optional — local JSON storage is used when omitted) ─────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Email Notifications (Resend) ──────────────────────────────────────────────
# Required for real email delivery. Sign up at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
# Sender address — must match a verified domain in your Resend account.
# During development, use: "Zubair Medical Complex <onboarding@resend.dev>"
EMAIL_FROM=Zubair Medical Complex <notifications@yourdomain.com>

# ── Hospital Notification Recipients ─────────────────────────────────────────
# Staff email that receives a notification when a patient books an appointment.
# Leave empty if email notifications are not needed (no fake address invented).
HOSPITAL_NOTIFICATION_EMAIL=
# Staff WhatsApp number that receives booking alerts (international format).
HOSPITAL_NOTIFICATION_WHATSAPP=+923156621341

# ── Meta WhatsApp Cloud API ───────────────────────────────────────────────────
# Complete setup guide:
#
# STEP 1: Create Meta Developer Account
#   → Go to https://developers.facebook.com → Create Account
#
# STEP 2: Create Meta App
#   → My Apps → Create App → Business → Give it a name
#
# STEP 3: Add WhatsApp Product
#   → In your App Dashboard → Add Product → WhatsApp → Set Up
#
# STEP 4: Get Credentials (API Setup page)
#   → WhatsApp → API Setup
#   → Copy "Phone number ID" → set as WHATSAPP_PHONE_NUMBER_ID
#   → Generate temporary access token → set as WHATSAPP_ACCESS_TOKEN
#   → For production: create a System User and generate permanent token
#
# STEP 5: Register a WhatsApp Business Phone Number
#   → Add phone number in WhatsApp Manager
#   → Verify with OTP
#   → Copy the Phone Number ID
#
# STEP 6: Create Message Template (for business-initiated messages)
#   → WhatsApp Manager → Message Templates → Create Template
#   → Category: UTILITY, Language: English
#   → Template name: appointment_confirmation (lowercase, underscores only)
#   → Template body:
#     Assalam-o-Alaikum {{1}}!
#
#     Your appointment at Zubair Medical Complex Jhelum has been confirmed.
#
#     Appointment ID: {{2}}
#     Doctor: {{3}}
#     Appointment Date: {{4}}
#     Appointment Time: {{5}}
#
#     Thank you for choosing Zubair Medical Complex Jhelum.
#     Please contact our reception if you need assistance.
#   → Submit for review (approval takes 24-48 hours)
#
# STEP 7: Configure Webhook
#   → App Dashboard → WhatsApp → Configuration → Webhooks
#   → Callback URL: https://zubairmedicalcomplexjhelum.vercel.app/api/whatsapp/webhook
#   → Verify Token: (same value as WHATSAPP_VERIFY_TOKEN below)
#   → Subscribe to: messages
#
# STEP 8: Add test numbers (for sandbox testing before template approval)
#   → API Setup → To (phone number field) → Add recipients
#   → These numbers can receive messages without template approval

# Obtain from https://developers.facebook.com/apps → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Template name (must match exactly what you created in WhatsApp Manager)
# Leave empty to use free-text messages (only works within 24hr window for replies)
WHATSAPP_TEMPLATE_NAME=appointment_confirmation
# Language code for the template (en, en_US, ur, etc.)
WHATSAPP_TEMPLATE_LANGUAGE=en

# API version — update when Meta releases a newer stable version
WHATSAPP_API_VERSION=v19.0

# Webhook verification token — MUST match what you enter in Meta Developer portal
# Generate a secure random string (e.g.: openssl rand -hex 32)
WHATSAPP_VERIFY_TOKEN=

# App Secret — found in App Dashboard → Settings → Basic → App Secret
# Used to verify webhook payloads via X-Hub-Signature-256 header
WHATSAPP_APP_SECRET=

# Legacy aliases (also supported for backwards compatibility)
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_TOKEN=

# ── Twilio SMS / WhatsApp (Optional alternative to Meta) ─────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Baileys Local WhatsApp Web Gateway (Optional — for local use only) ────────
# The local gateway (npm run whatsapp) connects your physical phone.
# On Vercel, use a public tunnel URL (ngrok / Cloudflare Tunnel).
WHATSAPP_GATEWAY_URL=http://localhost:5005

# ── Public Site URL (used to build dashboard links in emails) ─────────────────
# Set this to your production URL
NEXT_PUBLIC_SITE_URL=https://zubairmedicalcomplexjhelum.vercel.app
