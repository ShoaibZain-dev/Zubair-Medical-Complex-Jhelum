# ZUBAIR MEDICAL COMPLEX JHELUM
# Production Environment Variables

# Authentication Secret
AUTH_SECRET=zmc_jhelum_secure_token_secret_key_2026_production

# Optional Supabase Database Connection
# (The system has automated local persistent storage ready out-of-the-box,
# and can seamlessly connect to Supabase PostgreSQL when credentials are provided)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta WhatsApp Cloud API (Optional - will use mock audit mode if omitted)
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_TOKEN=

# Twilio SMS / WhatsApp (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
